    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freetab uses the camera to photograph receipts and transfer screenshots as evidence of a payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Freetab usa la cámara para fotografiar recibos y pantallazos de transferencias como evidencia de un abono."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freetab can lock itself with Face ID so only you can see your accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Freetab puede bloquearse con Face ID para que solo tú veas tus cuentas."
          }
        }
      }
    }
  },
  "version": "1.0"
